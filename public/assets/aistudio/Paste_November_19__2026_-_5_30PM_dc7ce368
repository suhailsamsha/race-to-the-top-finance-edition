                  <rect x="10" y="7" width="28" height="22" rx="3.5" fill="#0f172a" stroke="${color}" stroke-width="2"></rect>
                  <circle cx="24" cy="18" r="6" fill="rgba(0,0,0,0.6)" stroke="${secColor}" stroke-width="1.2"></circle>
                  <text x="24" y="22.5" text-anchor="middle" font-size="11" font-weight="900" fill="${idx===0 && s > 0 ? '#f59e0b' : '#34d399'}" font-family="system-ui, sans-serif">$</text>
                </svg>
              </div>
              <div class="vessel-hud-badge" style="border-left:3px solid ${color};">
                <span class="badge-rank-tag">${idx+1}</span>
