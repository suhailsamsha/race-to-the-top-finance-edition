      if (pageStripTitle) pageStripTitle.textContent = `Active: Round ${cur.id} • ${cur.name}`;

      ['page', 'modal'].forEach(p => {
        const nameEl = document.getElementById(`${p}-bench-round-name`);
        if (nameEl) nameEl.textContent = fullText;
