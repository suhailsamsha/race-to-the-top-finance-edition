<script>
    /* 1. INITIAL PRE-REGISTERED 5 CORPORATE FINANCE TEAMS (ALL START AT $0 & NO BADGES) */
    const INITIAL_FINANCE_TEAMS = [
      { id: 'team-1', name: 'Financial Planning & Analysis', leader: 'Chloe Bennett', color: '#10b981', secondaryColor: '#06b6d4', roundWins: [] },
      { id: 'team-2', name: 'Accounts Receivable', leader: 'Siddharth R.', color: '#3b82f6', secondaryColor: '#6366f1', roundWins: [] },
      { id: 'team-3', name: 'Corporate Finance & Treasury', leader: 'Elena Rostova', color: '#f43f5e', secondaryColor: '#e11d48', roundWins: [] },
      { id: 'team-4', name: 'Accounts Payable', leader: 'Maya Lin', color: '#f59e0b', secondaryColor: '#f97316', roundWins: [] },
      { id: 'team-5', name: 'Financial Reporting', leader: 'Marcus Cole', color: '#a855f7', secondaryColor: '#ec4899', roundWins: [] }
    ];

    const INITIAL_SCORES = {
      'team-1': 0,
      'team-2': 0,
      'team-3': 0,
      'team-4': 0,
      'team-5': 0
    };

    /* 2. OFFICIAL 8 COMPETITION ROUNDS CONFIGURATION */
    const GAME_ROUNDS = [
      { id: 1, name: 'Network champion', first: 100, second: 50, type: 'Challenge' },
      { id: 2, name: 'Case Study 1 - Master the Budget', first: 1000, second: 500, type: 'Case Study' },
      { id: 3, name: 'Count Down Challenge', first: 100, second: 50, type: 'Challenge' },
      { id: 4, name: 'Case Study 2 - The Cash Flow Challenge', first: 1000, second: 500, type: 'Case Study' },
      { id: 5, name: 'The Signature Hunt', first: 100, second: 50, type: 'Challenge' },
      { id: 6, name: 'Case Study 3 - Think Like a CFO', first: 1000, second: 500, type: 'Case Study' },
      { id: 7, name: 'Decode The Corporate Language', first: 100, second: 50, type: 'Challenge' },
      { id: 8, name: 'Revenue Short Fall Review Meeting', first: 1000, second: 500, type: 'Case Study' }
    ];

    /* APP STORAGE KEY & STATE */
    const STORAGE_KEY = 'race_to_the_top_finance_state_v1';

    let teams = [];
    let scores = {};
    let campaignGoal = 10000;
    let activeRoundId = 1;
    let roundHistory = [];
    let currentRole = 'audience';
    let selectedLeaderTeamId = 'team-1';
    let audioUnlocked = false;
    let audioCtx = null;
    let lastAwardedBadgeKey = null;

    /* 3. PERSISTENCE & REAL-TIME BROADCASTCHANNEL SYNC */
    let channel = null;
    try {
      if (typeof BroadcastChannel !== 'undefined') {
        channel = new BroadcastChannel('apex_race_channel');
      }
    } catch (e) {
      console.warn('BroadcastChannel not supported or restricted in this environment.');
    }

    function loadPersistedState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && Array.isArray(parsed.teams) && parsed.scores) {
            teams = parsed.teams;
            scores = parsed.scores;
            activeRoundId = parsed.activeRoundId || 1;
            roundHistory = parsed.roundHistory || [];
            campaignGoal = parsed.campaignGoal || 10000;
            return true;
          }
        }
      } catch (e) {
        console.error('Failed reading state:', e);
      }
      return false;
    }

    function initAppState() {
      const loaded = loadPersistedState();
      if (!loaded || !teams.length) {
        teams = JSON.parse(JSON.stringify(INITIAL_FINANCE_TEAMS));
        scores = { ...INITIAL_SCORES };
        activeRoundId = 1;
        roundHistory = [];
        campaignGoal = 10000;
        persistState(false);
      }
      selectedLeaderTeamId = teams[0]?.id || 'team-1';
      syncFormFieldsWithSelectedTeam();
    }

    function persistState(broadcast = true) {
      try {
        const payload = {
          teams,
          scores,
          activeRoundId,
          roundHistory,
          campaignGoal,
          timestamp: Date.now()
        };
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
        } catch(storageErr) {
          console.warn('LocalStorage error:', storageErr);
        }
        flashSavedIndicator();
        if (broadcast && channel) {
          channel.postMessage({ type: 'STATE_UPDATE', payload });
        }
      } catch (e) {
        console.error('Error saving state:', e);
      }
    }

    if (channel) {
      channel.onmessage = (event) => {
        if (event.data && event.data.type === 'STATE_UPDATE' && event.data.payload) {
          applyExternalPayload(event.data.payload);
        }
      };
    }

    window.addEventListener('storage', (e) => {
      if (e.key === STORAGE_KEY && e.newValue) {
        try {
          applyExternalPayload(JSON.parse(e.newValue));
        } catch(err){}
      }
    });

    function applyExternalPayload(payload) {
      if (payload.teams) teams = payload.teams;
      if (payload.scores) scores = payload.scores;
      if (payload.activeRoundId) activeRoundId = payload.activeRoundId;
      if (payload.roundHistory) roundHistory = payload.roundHistory;
      if (payload.campaignGoal) campaignGoal = payload.campaignGoal;
      flashSavedIndicator('Synced via apex_race_channel');
      syncFormFieldsWithSelectedTeam();
      renderAll();
    }

    function flashSavedIndicator(customText) {
      const pill = document.getElementById('storage-status-pill');
      const text = document.getElementById('storage-status-text');
      if (!pill || !text) return;
      const now = new Date().toLocaleTimeString([], { hour:'2-digit', minute:'2-digit', second:'2-digit' });
      text.textContent = customText || `Saved (${now})`;
      pill.classList.add('flash');
      setTimeout(() => pill.classList.remove('flash'), 1200);
    }

    /* Reliable seamless reset handler */
    function confirmAndResetCompetition(triggerBtn) {
      resetToInitialState(triggerBtn);
    }

    function resetCompetition(triggerBtn) {
      resetToInitialState(triggerBtn);
    }

    function resetToZero(triggerBtn) {
      resetToInitialState(triggerBtn);
    }

    function resetToInitialState(triggerBtn) {
      try {
        teams = JSON.parse(JSON.stringify(INITIAL_FINANCE_TEAMS));
        scores = { ...INITIAL_SCORES };
        activeRoundId = 1;
        roundHistory = [];
        campaignGoal = 10000;
        lastAwardedBadgeKey = null;
        selectedLeaderTeamId = teams[0]?.id || 'team-1';

        clearRoundSelections('modal');
        clearRoundSelections('page');

        try {
          localStorage.removeItem(STORAGE_KEY);
          sessionStorage.clear();
        } catch(storageErr) {
          console.warn('Storage cleanup issue:', storageErr);
        }

        persistState(true);
        syncFormFieldsWithSelectedTeam();
        renderAll();
        playResetSound();

        if (triggerBtn && triggerBtn.tagName) {
          const originalHTML = triggerBtn.innerHTML;
          triggerBtn.innerHTML = '✓ Reset Complete!';
          triggerBtn.classList.add('btn-reset-success');
          setTimeout(() => {
            triggerBtn.innerHTML = originalHTML;
            triggerBtn.classList.remove('btn-reset-success');
          }, 1800);
        }

        showToast('Competition reset to $0! All squadrons at starting line.');
      } catch (err) {
        console.error('Reset execution error:', err);
        showToast('Reset executed: Teams at $0');
      }
    }

    function formatDollars(val) {
      return '$' + (val || 0).toLocaleString();
    }

    /* 4. PROCEDURAL WEB AUDIO SYNTHESIZER (Cash Register, Chime, Fanfare, Reset Sweep) */
    function initAudio() {
      if (!audioCtx) {
        const AudioC = window.AudioContext || window.webkitAudioContext;
        if (AudioC) audioCtx = new AudioC();
      }
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
    }

    function toggleAudio() {
      initAudio();
      audioUnlocked = !audioUnlocked;
      const btn = document.getElementById('sound-btn');
      const icon = document.getElementById('sound-icon');
      if (audioUnlocked) {
        icon.textContent = '🔊';
        btn.classList.add('btn-sound-active');
        playCashChime();
        showToast('Real-time Web Audio Synthesizer Active! 💸');
      } else {
        icon.textContent = '🔇';
        btn.classList.remove('btn-sound-active');
        showToast('Sound Muted');
      }
    }

    function playCashChime() {
      if (!audioUnlocked || !audioCtx) return;
      try {
        const now = audioCtx.currentTime;
        const osc1 = audioCtx.createOscillator();
        const g1 = audioCtx.createGain();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(1975.5, now);
        g1.gain.setValueAtTime(0.25, now);
        g1.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
        osc1.connect(g1); g1.connect(audioCtx.destination);
        osc1.start(now); osc1.stop(now + 0.36);

        const osc2 = audioCtx.createOscillator();
        const g2 = audioCtx.createGain();
        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(2637.0, now + 0.08);
        g2.gain.setValueAtTime(0.32, now + 0.08);
        g2.gain.exponentialRampToValueAtTime(0.001, now + 0.7);
        osc2.connect(g2); g2.connect(audioCtx.destination);
        osc2.start(now + 0.08); osc2.stop(now + 0.71);
      } catch(e) {}
    }

    function playCoinDrop() {
      if (!audioUnlocked || !audioCtx) return;
      try {
        const now = audioCtx.currentTime;
        [1800, 2200, 2600].forEach((freq, idx) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          const t = now + idx * 0.06;
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, t);
          gain.gain.setValueAtTime(0.18, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
          osc.connect(gain); gain.connect(audioCtx.destination);
          osc.start(t); osc.stop(t + 0.21);
        });
      } catch(e) {}
    }

    function playResetSound() {
      if (!audioUnlocked || !audioCtx) return;
      try {
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(600, now);
        osc.frequency.exponentialRampToValueAtTime(150, now + 0.35);
        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.36);
      } catch(e) {}
    }

    function playFanfare() {
      if (!audioUnlocked || !audioCtx) return;
      try {
        const notes = [523.25, 659.25, 783.99, 1046.50];
        const now = audioCtx.currentTime;
        notes.forEach((freq, idx) => {
          const osc = audioCtx.createOscillator();
          const g = audioCtx.createGain();
          const t = now + idx * 0.1;
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(freq, t);
          g.gain.setValueAtTime(0.2, t);
          g.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
          osc.connect(g); g.connect(audioCtx.destination);
          osc.start(t); osc.stop(t + 0.42);
        });
      } catch(e) {}
    }

    function showToast(msg) {
      const t = document.getElementById('toast-msg');
      if (!t) return;
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2600);
    }

    /* 5. ROUND CONTROLS & DYNAMIC BADGE ALLOTMENT */
    function getActiveRound() {
      return GAME_ROUNDS.find(r => r.id === activeRoundId) || GAME_ROUNDS[0];
    }

    function setActiveRound(id) {
      activeRoundId = id;
      persistState();
      renderAll();
      const r = getActiveRound();
      showToast(`Active Round set to Round ${r.id}: ${r.name}`);
      playCoinDrop();
    }

    function addTeamRoundWin(teamId, roundId, roundName, place, amount) {
      const team = teams.find(t => t.id === teamId);
      if (!team) return;
      if (!team.roundWins) team.roundWins = [];
      team.roundWins = team.roundWins.filter(w => w.roundId !== roundId);
      team.roundWins.unshift({
        roundId,
        roundName,
        place,
        amount,
        timestamp: Date.now()
      });
      lastAwardedBadgeKey = `${teamId}-r${roundId}`;
    }

    function awardSelectedRoundPoints(source = 'page') {
      const prefix = source === 'modal' ? 'modal-' : 'page-';
      const s1 = document.getElementById(`${prefix}select-round-1st`);
      const s2 = document.getElementById(`${prefix}select-round-2nd`);
      const t1 = s1 ? s1.value : '';
      const t2 = s2 ? s2.value : '';

      if (!t1 && !t2) return showToast('Please select at least 1st or 2nd place team!');
      if (t1 && t2 && t1 === t2) return showToast('One squadron cannot take both 1st and 2nd in the same round!');

      const r = getActiveRound();
      let summary = [];

      if (t1) {
        scores[t1] = (scores[t1] || 0) + r.first;
        const name = teams.find(t => t.id === t1)?.name || 'Squadron';
        summary.push(`1st: ${name} (+${formatDollars(r.first)})`);
        logRound(r.id, r.name, name, '1st', r.first);
        addTeamRoundWin(t1, r.id, r.name, 1, r.first);
      }
      if (t2) {
        scores[t2] = (scores[t2] || 0) + r.second;
        const name = teams.find(t => t.id === t2)?.name || 'Squadron';
        summary.push(`2nd: ${name} (+${formatDollars(r.second)})`);
        logRound(r.id, r.name, name, '2nd', r.second);
        addTeamRoundWin(t2, r.id, r.name, 2, r.second);
      }

      const maxScore = Math.max(...Object.values(scores));
      if (maxScore >= campaignGoal) {
        triggerConfetti();
        playFanfare();
      } else {
        playCashChime();
      }

      if (activeRoundId < GAME_ROUNDS.length) {
        activeRoundId += 1;
      }

      persistState();
      renderAll();
      showToast(`Awarded Round ${r.id}: ${summary.join(' & ')}! 💸`);
      clearRoundSelections('modal');
      clearRoundSelections('page');
    }

    function quickAllot(teamId, place) {
      const r = getActiveRound();
      const pts = place === 1 ? r.first : r.second;
      scores[teamId] = (scores[teamId] || 0) + pts;
      const name = teams.find(t => t.id === teamId)?.name || 'Squadron';
      logRound(r.id, r.name, name, place === 1 ? '1st' : '2nd', pts);
      addTeamRoundWin(teamId, r.id, r.name, place, pts);

      persistState();
      renderAll();
      playCashChime();
      showToast(`Awarded Round ${r.id} ${place === 1 ? '1st 🥇' : '2nd 🥈'} (+${formatDollars(pts)}) to ${name}!`);
    }

    function adjustFunds(teamId, delta) {
      scores[teamId] = Math.max(0, (scores[teamId] || 0) + delta);
      const name = teams.find(t => t.id === teamId)?.name || 'Squadron';
      persistState();
      renderAll();
      playCashChime();
      showToast(`${delta > 0 ? '+' : ''}${formatDollars(delta)} adjusted for ${name}`);
    }

    function applyCustomTeamInput(teamId) {
      const input = document.getElementById(`custom-amt-${teamId}`);
      if (!input) return;
      const val = parseInt(input.value, 10);
      if (isNaN(val) || val === 0) return;
      adjustFunds(teamId, val);
      input.value = '';
    }

    function logRound(roundId, roundName, teamName, place, amount) {
      roundHistory.unshift({
        roundId, roundName, teamName, place, amount,
        time: new Date().toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' })
      });
      if (roundHistory.length > 40) roundHistory.pop();
    }

    function clearRoundHistory() {
      roundHistory = [];
      persistState();
      renderRoundHistory();
      showToast('Round award log cleared');
    }

    function clearRoundSelections(source = 'page') {
      const prefix = source === 'modal' ? 'modal-' : 'page-';
      const s1 = document.getElementById(`${prefix}select-round-1st`);
      const s2 = document.getElementById(`${prefix}select-round-2nd`);
      if (s1) s1.value = '';
      if (s2) s2.value = '';
    }

    /* 6. RENDERING FUNCTIONS */
    function renderRoundButtons(targetId) {
      const container = document.getElementById(targetId);
      if (!container) return;
      container.innerHTML = GAME_ROUNDS.map(r => {
        const isActive = r.id === activeRoundId;
        const isCase = r.type === 'Case Study';
        const hasWon = teams.some(t => (t.roundWins || []).some(w => w.roundId === r.id));
        return `
          <button class="round-card-btn ${isActive ? 'active' : ''} ${isCase ? 'case-study' : ''} ${hasWon ? 'has-won' : ''}" onclick="setActiveRound(${r.id})" type="button">
            <span class="r-num">Round ${r.id} • ${r.type} ${hasWon ? '✓' : ''}</span>
            <span class="r-title" title="${r.name}">${r.name}</span>
            <span class="r-points">1st: +${formatDollars(r.first)} | 2nd: +${formatDollars(r.second)}</span>
          </button>
        `;
      }).join('');
    }

    function populateSelects(selectId) {
      const s = document.getElementById(selectId);
      if (!s) return;
      const cur = s.value;
      const options = `<option value="">-- Choose Squadron --</option>` + teams.map(t => {
        return `<option value="${t.id}">${t.name} (${formatDollars(scores[t.id])})</option>`;
      }).join('');
