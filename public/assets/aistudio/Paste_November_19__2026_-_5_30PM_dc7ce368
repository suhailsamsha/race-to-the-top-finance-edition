<!DOCTYPE html>

<html data-theme="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport"/>
<title>Race to the Top - Finance Edition</title>
<style>
    :root {
      --bg: #030712;
      --bg-card: rgba(13, 20, 38, 0.92);
      --bg-card-solid: #0f172a;
      --border: rgba(255, 255, 255, 0.09);
      --border-focus: #10b981;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --primary: #10b981;
      --gold: #f59e0b;
      --silver: #cbd5e1;
      --cyan: #38bdf8;
      --danger: #ef4444;
      --shadow: 0 16px 36px -6px rgba(0, 0, 0, 0.7);
      --font: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font);
      background-color: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 16px;
      overflow-x: hidden;
      position: relative;
    }
    #space-bg-canvas, #confetti-canvas {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;
    }
    #space-bg-canvas { z-index: 0; }
    #confetti-canvas { z-index: 9998; }

    .app-container {
      max-width: 1340px; margin: 0 auto; width: 100%; display: flex; flex-direction: column; gap: 16px; position: relative; z-index: 1;
    }
    header {
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;
      padding: 14px 20px; background: var(--bg-card); backdrop-filter: blur(16px);
      border: 1px solid var(--border); border-radius: 18px; box-shadow: var(--shadow);
    }
    .brand { display: flex; align-items: center; gap: 12px; }
    .brand-icon { font-size: 28px; }
    .brand-text h1 {
      font-size: 1.25rem; font-weight: 800; background: linear-gradient(135deg, #34d399, #f59e0b, #38bdf8);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .brand-text span { font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      padding: 8px 14px; border-radius: 10px; font-size: 0.82rem; font-weight: 600;
      border: 1px solid var(--border); background: var(--bg-card-solid); color: var(--text);
      cursor: pointer; transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1); user-select: none;
    }
    .btn:hover { filter: brightness(1.15); transform: translateY(-1px); border-color: rgba(255,255,255,0.25); }
    .btn:active { transform: translateY(0); }
    .btn-primary { background: linear-gradient(135deg, #10b981, #059669); color: #fff; border: none; box-shadow: 0 4px 12px rgba(16,185,129,0.35); }
    .btn-gold { background: linear-gradient(135deg, #f59e0b, #d97706); color: #000; font-weight: 800; border: none; }
    .btn-danger { background: rgba(239, 68, 68, 0.18); border-color: rgba(239, 68, 68, 0.45); color: #fca5a5; }
    .btn-danger:hover { background: rgba(239, 68, 68, 0.3); border-color: #ef4444; }
    .btn-reset-header {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(185, 28, 28, 0.28));
      border: 1px solid rgba(239, 68, 68, 0.55);
      color: #fecaca;
      box-shadow: 0 0 12px rgba(239, 68, 68, 0.2);
      font-weight: 700;
    }
    .btn-reset-header:hover {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.35), rgba(220, 38, 38, 0.45));
      border-color: #ef4444;
      color: #fff;
      box-shadow: 0 0 16px rgba(239, 68, 68, 0.4);
    }
    .btn-reset-success {
      background: linear-gradient(135deg, #059669, #10b981) !important;
      border-color: #34d399 !important;
      color: #ffffff !important;
      box-shadow: 0 0 16px rgba(16, 185, 129, 0.6) !important;
    }
    .btn-sound-active { background: linear-gradient(135deg, #059669, #0d9488); border-color: #34d399; color: #ecfdf5; box-shadow: 0 0 14px rgba(16,185,129,0.45); }
    .btn-sm { padding: 5px 10px; font-size: 0.75rem; border-radius: 8px; }

    .role-bar {
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px;
      padding: 10px 18px; background: linear-gradient(90deg, rgba(13,20,38,0.95), rgba(16,24,46,0.95));
      border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 16px;
    }
    .role-tabs { display: inline-flex; background: rgba(0,0,0,0.45); padding: 4px; border-radius: 12px; gap: 4px; border: 1px solid var(--border); }
    .role-tab {
      padding: 6px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 700;
      color: var(--text-muted); cursor: pointer; border: none; background: transparent; transition: all 0.2s;
    }
    .role-tab.active { background: linear-gradient(135deg, #10b981, #059669); color: #fff; box-shadow: 0 2px 10px rgba(16,185,129,0.4); }

    /* Auto-save flash pill */
    .save-indicator {
      display: inline-flex; align-items: center; gap: 6px; font-size: 0.72rem; color: var(--text-dim);
      padding: 3px 9px; border-radius: 999px; background: rgba(0,0,0,0.35); border: 1px solid var(--border);
      transition: all 0.3s;
    }
    .save-indicator.flash {
      color: #6ee7b7; border-color: #10b981; background: rgba(16, 185, 129, 0.2); box-shadow: 0 0 10px rgba(16, 185, 129, 0.3);
    }

    /* Collapsible Sections & Controls */
    .collapsible-card {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: 18px; overflow: hidden;
      animation: fadeIn 0.25s ease-out;
    }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
    .card-header { padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; cursor: pointer; border-bottom: 1px solid var(--border); user-select: none; }
    .card-header h2 { font-size: 0.95rem; font-weight: 700; display: flex; align-items: center; gap: 8px; }
    .card-body { padding: 18px; display: flex; flex-direction: column; gap: 16px; }

    /* Admin Round Strip Buttons */
    .round-control-container {
      background: linear-gradient(145deg, rgba(17, 24, 39, 0.95), rgba(10, 15, 30, 0.98));
      border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 16px; padding: 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 0 20px rgba(56, 189, 248, 0.05);
    }
    .round-strip {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: 8px; margin-bottom: 16px;
    }
    .round-card-btn {
      display: flex; flex-direction: column; align-items: flex-start; gap: 4px; padding: 10px 12px;
      background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border); border-radius: 12px;
      cursor: pointer; color: var(--text); text-align: left; transition: all 0.2s;
    }
    .round-card-btn:hover { background: rgba(56, 189, 248, 0.1); border-color: rgba(56, 189, 248, 0.5); transform: translateY(-2px); }
    .round-card-btn.active {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.25), rgba(56, 189, 248, 0.2));
      border-color: #38bdf8; box-shadow: 0 0 14px rgba(56, 189, 248, 0.25);
    }
    .round-card-btn.has-won {
      border-color: rgba(245, 158, 11, 0.6);
    }
    .round-card-btn .r-num { font-size: 0.68rem; font-weight: 800; color: #38bdf8; text-transform: uppercase; letter-spacing: 0.05em; }
    .round-card-btn .r-title { font-size: 0.78rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; }
    .round-card-btn .r-points { font-size: 0.68rem; color: #34d399; font-weight: 700; }
    .round-card-btn.case-study .r-points { color: #f59e0b; }

    .round-workbench {
      display: grid; grid-template-columns: 1fr; gap: 16px; padding: 16px;
      background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 14px;
    }
    @media (min-width: 900px) { .round-workbench { grid-template-columns: 1.35fr 1fr; } }
    .podium-selector-row {
      display: grid; grid-template-columns: 100px 1fr auto; align-items: center; gap: 10px;
      background: rgba(255, 255, 255, 0.03); padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border); margin-bottom: 8px;
    }
    .podium-badge { font-size: 0.74rem; font-weight: 800; padding: 4px 8px; border-radius: 6px; display: inline-flex; align-items: center; gap: 4px; }
    .podium-gold { background: rgba(245, 158, 11, 0.2); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.4); }
    .podium-silver { background: rgba(148, 163, 184, 0.2); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.4); }
    .prize-tag { font-weight: 800; font-size: 0.88rem; color: #34d399; min-width: 70px; text-align: right; }

    .round-history-log {
      max-height: 200px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; padding-right: 4px;
    }
    .history-entry {
      display: flex; justify-content: space-between; align-items: center; padding: 7px 11px;
      background: rgba(255, 255, 255, 0.02); border-radius: 8px; border-left: 3px solid #38bdf8; font-size: 0.75rem;
    }
    .history-entry.gold-win { border-left-color: #f59e0b; }
    .history-entry.silver-win { border-left-color: #94a3b8; }

    /* Tables */
    .sk-table-container { overflow-x: auto; border-radius: 12px; border: 1px solid var(--border); background: rgba(0,0,0,0.3); }
    .sk-table { width: 100%; border-collapse: collapse; font-size: 0.82rem; min-width: 760px; }
    .sk-table th { background: rgba(255,255,255,0.03); padding: 11px 14px; text-align: left; font-weight: 600; color: var(--text-muted); border-bottom: 1px solid var(--border); }
    .sk-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }

    /* Arena & Flight Track */
    .cosmos-flight-arena {
      position: relative; background: radial-gradient(circle at 50% 10%, #11222e 0%, #091322 45%, #030712 95%);
      border: 1px solid rgba(52, 211, 153, 0.25); border-radius: 24px; padding: 22px;
      box-shadow: 0 25px 60px -10px rgba(0, 0, 0, 0.8), inset 0 0 80px rgba(16, 185, 129, 0.08);
      overflow: hidden; min-height: 560px; display: flex; flex-direction: column; gap: 14px;
    }
    .celestial-planet {
      position: absolute; bottom: -160px; left: -80px; width: 440px; height: 440px; border-radius: 50%;
      background: radial-gradient(circle at 45% 30%, #34d399 0%, #059669 35%, #0f172a 80%);
      box-shadow: 0 -20px 80px rgba(16, 185, 129, 0.3); opacity: 0.45; pointer-events: none; z-index: 0;
    }
    .stargate-finish {
      position: absolute; top: 20px; bottom: 20px; right: 28px; width: 6px; border-radius: 999px;
      background: linear-gradient(180deg, #ec4899, #f59e0b 45%, #34d399);
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.8), 0 0 45px rgba(52, 211, 153, 0.6); z-index: 2;
    }
    .stargate-label {
      position: absolute; right: 38px; top: 24px; font-size: 0.72rem; font-weight: 800; color: #f59e0b;
      letter-spacing: 0.08em; text-transform: uppercase; background: rgba(0,0,0,0.6); padding: 3px 8px; border-radius: 6px;
      border: 1px solid rgba(245,158,11,0.3); z-index: 3;
    }

    /* Floating Cash Vessels */
    .flight-stage { position: relative; z-index: 5; width: 100%; min-height: 420px; flex-grow: 1; }
    .space-vessel {
      position: absolute; transform: translate3d(0, 0, 0); will-change: transform, left, top; z-index: 10;
      transition: left 0.85s cubic-bezier(0.2, 0.9, 0.3, 1.1), top 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.1);
      display: flex; align-items: center; cursor: pointer;
    }
    .cash-hull {
      width: 48px; height: 38px; display: flex; align-items: center; justify-content: center; position: relative;
      filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.95)); flex-shrink: 0;
    }
    .cash-hull::after {
      content: ''; position: absolute; left: -10px; top: 50%; transform: translateY(-50%);
      width: 14px; height: 10px; border-radius: 50%;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.9) 0%, rgba(56, 189, 248, 0) 80%);
      animation: thrusterPulse 0.8s infinite alternate ease-in-out; pointer-events: none;
    }
    @keyframes thrusterPulse {
      0% { opacity: 0.4; transform: translateY(-50%) scale(0.85); }
      100% { opacity: 1; transform: translateY(-50%) scale(1.35); }
    }

    .vessel-hud-badge {
      margin-left: 6px; background: rgba(15, 23, 42, 0.92); border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 6px 12px; border-radius: 14px; backdrop-filter: blur(12px); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
      display: flex; align-items: center; gap: 8px; white-space: nowrap; transition: all 0.25s;
    }
    .space-vessel:hover .vessel-hud-badge {
      transform: scale(1.03); border-color: rgba(255,255,255,0.4);
    }
    .space-vessel.lead-vessel .vessel-hud-badge {
      border-color: rgba(245, 158, 11, 0.7); background: linear-gradient(135deg, rgba(245, 158, 11, 0.22), rgba(15, 23, 42, 0.95));
      box-shadow: 0 0 22px rgba(245, 158, 11, 0.45);
    }
    .badge-rank-tag { font-size: 0.68rem; font-weight: 800; padding: 2px 7px; border-radius: 6px; background: rgba(255, 255, 255, 0.1); }
    .lead-vessel .badge-rank-tag { background: #f59e0b; color: #000; }
    .badge-name { font-size: 0.84rem; font-weight: 700; color: #fff; }
    .badge-val { font-size: 1.05rem; font-weight: 900; color: #34d399; }

    /* Dynamic Round Win Badges */
    .vessel-wins-strip {
      display: flex; align-items: center; gap: 5px; border-left: 1px solid rgba(255, 255, 255, 0.12);
      padding-left: 8px; margin-left: 2px;
    }
    .r-win-pill {
      font-size: 0.68rem; font-weight: 800; padding: 3px 8px; border-radius: 999px;
      display: inline-flex; align-items: center; gap: 4px; letter-spacing: 0.02em;
      transition: all 0.2s; white-space: nowrap; cursor: help;
    }
    .r-win-pill:hover { transform: scale(1.08); }
    .r-win-gold {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.35), rgba(180, 83, 9, 0.45));
      border: 1px solid #f59e0b; color: #fef08a; box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
    }
    .r-win-silver {
      background: linear-gradient(135deg, rgba(148, 163, 184, 0.25), rgba(71, 85, 105, 0.4));
      border: 1px solid #cbd5e1; color: #f1f5f9; box-shadow: 0 0 8px rgba(203, 213, 225, 0.35);
    }
    @keyframes badgePop {
      0% { transform: scale(0.3); opacity: 0; }
      50% { transform: scale(1.35); }
      100% { transform: scale(1); opacity: 1; }
    }
    .badge-pop-animate {
      animation: badgePop 0.55s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    #toast-msg {
      position: fixed; bottom: 20px; right: 20px; background: #0f172a; color: #fff;
      padding: 10px 18px; border-radius: 12px; border: 1px solid rgba(16, 185, 129, 0.4);
      box-shadow: 0 10px 30px rgba(0,0,0,0.7); font-size: 0.84rem; font-weight: 600;
      z-index: 10000; transform: translateY(100px); opacity: 0; transition: all 0.3s; pointer-events: none;
    }
    #toast-msg.show { transform: translateY(0); opacity: 1; }

    /* Admin Modal */
    .admin-modal-backdrop {
      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.82); backdrop-filter: blur(8px);
      z-index: 9999; display: none; align-items: center; justify-content: center; padding: 16px;
    }
    .admin-modal-backdrop.open { display: flex; }
    .admin-modal-panel {
      background: #0f172a; border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 20px;
      max-width: 840px; width: 100%; max-height: 90vh; overflow-y: auto; padding: 22px;
      box-shadow: 0 25px 60px rgba(0,0,0,0.85); display: flex; flex-direction: column; gap: 18px;
    }

    /* Dedicated Team Edit Modal */
    .edit-modal-backdrop {
      position: fixed; inset: 0; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(10px);
      z-index: 10005; display: none; align-items: center; justify-content: center; padding: 16px;
    }
    .edit-modal-backdrop.open { display: flex; }
    .edit-modal-panel {
      background: #0b1120; border: 1px solid rgba(56, 189, 248, 0.4); border-radius: 20px;
      max-width: 520px; width: 100%; padding: 24px; box-shadow: 0 25px 60px rgba(0,0,0,0.9);
      display: flex; flex-direction: column; gap: 18px; position: relative;
    }

    /* Ensure form text inputs can be selected and typed into freely */
    input[type="text"], input[type="number"], select {
      user-select: text !important;
      -webkit-user-select: text !important;
      pointer-events: auto !important;
      cursor: text;
    }
    select { cursor: pointer; }

    /* Projector Mode */
    body.projector-active { padding: 10px; background: #020617; }
    body.projector-active header,
    body.projector-active .role-bar,
    body.projector-active #registration-section,
    body.projector-active #scorekeeper-section,
    body.projector-active #audience-standings-section { display: none !important; }
    body.projector-active .cosmos-flight-arena { min-height: calc(100vh - 20px); border: none; background: transparent; }
    #projector-exit-btn {
      position: fixed; top: 16px; right: 16px; z-index: 10001; display: none; background: rgba(0,0,0,0.85);
      border: 1px solid rgba(255,255,255,0.4); color: #fff; padding: 7px 16px; border-radius: 10px; font-weight: 700; cursor: pointer;
    }
    body.projector-active #projector-exit-btn { display: block; }
  </style>
</head>
<body>
<canvas id="space-bg-canvas"></canvas>
<canvas id="confetti-canvas"></canvas>
<button id="projector-exit-btn" onclick="toggleProjector(false)">✕ Exit Projector</button>
<div id="toast-msg">Cosmos live telemetry active</div>
<!-- Dedicated Edit Squadron & Commander Modal -->
<div class="edit-modal-backdrop" id="edit-team-modal" onclick="if(event.target===this) closeEditTeamModal()">
<div class="edit-modal-panel">
<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:12px;">
<div style="display:flex; align-items:center; gap:10px;">
<span style="font-size:1.4rem;">✏️</span>
<div>
<h2 style="font-size:1.15rem; font-weight:800; color:#fff;">Edit Squadron &amp; Commander</h2>
<p style="font-size:0.75rem; color:var(--text-muted);">Change squadron title and commander name</p>
</div>
</div>
<button class="btn btn-sm" onclick="closeEditTeamModal()" style="font-size:1rem; padding:4px 10px;" type="button">✕</button>
</div>
<form id="modal-edit-team-form" onsubmit="handleModalEditSubmit(event)" style="display:flex; flex-direction:column; gap:14px;">
<input id="modal-edit-team-id" type="hidden"/>
<div>
<label for="modal-edit-team-name" style="font-size:0.78rem; font-weight:700; color:#38bdf8; display:block; margin-bottom:6px;">
          Squadron Name
        </label>
<input id="modal-edit-team-name" required="" style="width:100%; padding:10px 14px; background:rgba(0,0,0,0.6); border:1px solid var(--border); border-radius:10px; color:#fff; font-size:0.9rem;" type="text"/>
</div>
<div>
<label for="modal-edit-leader-name" style="font-size:0.78rem; font-weight:700; color:#34d399; display:block; margin-bottom:6px;">
          Commander / Team Leader Name
        </label>
<input autocomplete="off" id="modal-edit-leader-name" required="" style="width:100%; padding:10px 14px; background:rgba(0,0,0,0.6); border:1px solid var(--border); border-radius:10px; color:#fff; font-size:0.9rem;" type="text"/>
</div>
<div style="display:flex; align-items:center; gap:12px;">
<div style="flex:1;">
<label for="modal-edit-team-color" style="font-size:0.78rem; font-weight:700; color:var(--text-muted); display:block; margin-bottom:6px;">
            Hull Accent Color
          </label>
<input id="modal-edit-team-color" style="width:100%; height:40px; padding:2px; background:rgba(0,0,0,0.5); border:1px solid var(--border); border-radius:8px; cursor:pointer;" type="color"/>
</div>
<div style="flex:1;">
<label style="font-size:0.78rem; font-weight:700; color:var(--text-muted); display:block; margin-bottom:6px;">
            Current Balance
          </label>
<div id="modal-edit-balance-display" style="font-size:1.15rem; font-weight:900; color:#34d399; padding-top:6px;">$0</div>
</div>
</div>
<div style="display:flex; gap:10px; justify-content:flex-end; margin-top:8px; border-top:1px solid var(--border); padding-top:14px;">
<button class="btn" onclick="closeEditTeamModal()" style="padding:9px 18px;" type="button">Cancel</button>
<button class="btn btn-primary" id="modal-edit-save-btn" style="padding:9px 22px;" type="submit">💾 Save Changes</button>
</div>
</form>
</div>
</div>
<!-- Admin Modal / Drawer -->
<div class="admin-modal-backdrop" id="admin-modal" onclick="if(event.target===this) toggleAdminModal(false)">
<div class="admin-modal-panel">
<div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid var(--border); padding-bottom:12px;">
<div style="display:flex; align-items:center; gap:10px;">
<span style="font-size:1.4rem;">🔒</span>
<div>
<h2 style="font-size:1.15rem; font-weight:800; color:#fff;">Admin Command Console</h2>
<p style="font-size:0.75rem; color:var(--text-muted);">Manage official 8 rounds, points allotment &amp; flight progress</p>
</div>
</div>
<button class="btn btn-sm" onclick="toggleAdminModal(false)" style="font-size:1rem; padding:4px 10px;">✕</button>
