            <td>
              <div style="display:flex; gap:4px; align-items:center;">
                <input id="custom-amt-${t.id}" type="number" placeholder="±Amt" step="50" style="width:75px; padding:4px 6px; font-size:0.72rem; background:rgba(0,0,0,0.5); border:1px solid var(--border); border-radius:6px; color:#fff;" />
                <button class="btn btn-sm btn-primary" onclick="applyCustomTeamInput('${t.id}')" style="padding:4px 8px; font-size:0.72rem;">Apply</button>
              </div>
            </td>
            <td>
              <button class="btn btn-sm" onclick="openEditTeamModal('${t.id}')" style="font-size:0.72rem; padding:4px 8px; border-color:rgba(56,189,248,0.4); color:#38bdf8;">✏️ Edit</button>
            </td>
          </tr>
        `;
      }).join('');

      const pageTable = document.getElementById('page-sk-tbody');
      if (pageTable) pageTable.innerHTML = rows;

      const modalTable = document.getElementById('modal-sk-tbody');
      if (modalTable) {
        modalTable.innerHTML = teams.map(t => {
          const s = scores[t.id] || 0;
          return `
            <tr>
              <td><strong>${t.name}</strong></td>
              <td style="color:var(--text-muted); font-size:0.78rem;">${t.leader}</td>
              <td><strong style="color:#34d399;">${formatDollars(s)}</strong></td>
              <td>
                <div style="display:flex; gap:4px;">
                  <button class="btn btn-sm" onclick="adjustFunds('${t.id}', 1000)">+1000</button>
                  <button class="btn btn-sm" onclick="adjustFunds('${t.id}', 500)">+500</button>
                  <button class="btn btn-sm" onclick="adjustFunds('${t.id}', 100)">+100</button>
                </div>
              </td>
              <td>
                <button class="btn btn-sm btn-danger" onclick="adjustFunds('${t.id}', -100)">-100</button>
              </td>
            </tr>
          `;
        }).join('');
      }
    }

    function renderTeamLeaderSection(sorted) {
      const switcher = document.getElementById('team-leader-switcher-bar');
      if (switcher) {
        switcher.innerHTML = teams.map(t => {
          const isSel = t.id === selectedLeaderTeamId;
          const color = t.color || '#38bdf8';
          return `
            <button type="button" onclick="selectLeaderTeam('${t.id}')" style="padding:6px 12px; border-radius:10px; font-size:0.75rem; font-weight:700; cursor:pointer; background:${isSel ? 'rgba(255,255,255,0.15)' : 'rgba(0,0,0,0.35)'}; border:1px solid ${isSel ? color : 'var(--border)'}; color:#fff; display:inline-flex; align-items:center; gap:6px;">
              <span style="width:8px; height:8px; border-radius:50%; background:${color};"></span>
              <span>${t.name}</span>
              <span style="color:#34d399; font-weight:800;">${formatDollars(scores[t.id])}</span>
            </button>
          `;
        }).join('');
      }

      const card = document.getElementById('leader-telemetry-card');
      if (card) {
        const team = teams.find(t => t.id === selectedLeaderTeamId) || teams[0];
        if (team) {
          const rank = sorted.findIndex(t => t.id === team.id) + 1;
          const teamScore = scores[team.id] || 0;
          const leadScore = scores[sorted[0]?.id] || 0;
          const gap = leadScore - teamScore;
          const color = team.color || '#10b981';

          const winPills = (team.roundWins || []).map(w => {
            const isGold = w.place === 1;
            return `<span class="r-win-pill ${isGold ? 'r-win-gold' : 'r-win-silver'}" title="R${w.roundId}: ${w.roundName}">R${w.roundId} ${isGold ? '🥇' : '🥈'}</span>`;
          }).join(' ');

          card.innerHTML = `
            <div style="border-left:4px solid ${color}; padding-left:10px;">
              <div style="font-size:0.7rem; color:#94a3b8; text-transform:uppercase; font-weight:700;">Squadron Name</div>
              <div style="font-size:1rem; font-weight:800; color:#fff;">${team.name}</div>
              <div style="font-size:0.78rem; color:#38bdf8; margin-top:2px;">👨‍✈️ Commander: <strong style="color:#fff;">${team.leader}</strong></div>
            </div>
            <div>
              <div style="font-size:0.7rem; color:#94a3b8; text-transform:uppercase; font-weight:700;">Current Rank</div>
              <div style="font-size:1.35rem; font-weight:900; color:${rank === 1 && teamScore > 0 ? '#f59e0b' : '#fff'};">#${rank} <span style="font-size:0.8rem; font-weight:600; color:#94a3b8;">of ${teams.length}</span></div>
            </div>
            <div>
              <div style="font-size:0.7rem; color:#94a3b8; text-transform:uppercase; font-weight:700;">Total Funds &amp; Round Wins</div>
              <div style="font-size:1.35rem; font-weight:900; color:#34d399;">${formatDollars(teamScore)}</div>
              <div style="margin-top:4px; display:flex; gap:4px; flex-wrap:wrap;">${winPills || '<span style="color:var(--text-dim); font-size:0.7rem;">No round wins yet</span>'}</div>
            </div>
            <div>
              <div style="font-size:0.7rem; color:#94a3b8; text-transform:uppercase; font-weight:700;">Gap to 1st Place</div>
              <div style="font-size:1.1rem; font-weight:800; color:${gap === 0 ? '#f59e0b' : '#f43f5e'};">
                ${gap === 0 ? (teamScore > 0 ? '🏆 P1 Leader!' : 'Tied ($0)') : `-${formatDollars(gap)}`}
              </div>
            </div>
          `;
        }
      }
    }

    function syncFormFieldsWithSelectedTeam() {
      const team = teams.find(t => t.id === selectedLeaderTeamId) || teams[0];
      if (team) {
        const idInp = document.getElementById('reg-team-id');
        const nameInp = document.getElementById('reg-team-name');
        const leadInp = document.getElementById('reg-leader-name');
        const colorInp = document.getElementById('reg-team-color');
        if (idInp) idInp.value = team.id;
        if (nameInp) nameInp.value = team.name;
        if (leadInp) leadInp.value = team.leader;
        if (colorInp && team.color) colorInp.value = team.color;
      }
    }

    function selectLeaderTeam(teamId) {
      selectedLeaderTeamId = teamId;
      const team = teams.find(t => t.id === teamId);
      if (team) {
        syncFormFieldsWithSelectedTeam();
        renderAll();
      }
    }

    /* DEDICATED EDIT TEAM MODAL HANDLERS */
    function openEditTeamModal(teamId) {
      const team = teams.find(t => t.id === teamId);
      if (!team) return;
      const modal = document.getElementById('edit-team-modal');
      const idInp = document.getElementById('modal-edit-team-id');
      const nameInp = document.getElementById('modal-edit-team-name');
      const leadInp = document.getElementById('modal-edit-leader-name');
      const colorInp = document.getElementById('modal-edit-team-color');
      const balDisp = document.getElementById('modal-edit-balance-display');

      if (idInp) idInp.value = team.id;
      if (nameInp) nameInp.value = team.name;
      if (leadInp) leadInp.value = team.leader;
      if (colorInp && team.color) colorInp.value = team.color;
      if (balDisp) balDisp.textContent = formatDollars(scores[team.id] || 0);

      if (modal) modal.classList.add('open');
      setTimeout(() => {
        if (nameInp) {
          nameInp.focus();
          nameInp.select();
        }
      }, 50);
    }

    function closeEditTeamModal() {
      const modal = document.getElementById('edit-team-modal');
      if (modal) modal.classList.remove('open');
    }

    function handleModalEditSubmit(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      const idInp = document.getElementById('modal-edit-team-id');
      const nameInp = document.getElementById('modal-edit-team-name');
      const leadInp = document.getElementById('modal-edit-leader-name');
      const colorInp = document.getElementById('modal-edit-team-color');

      const targetId = idInp ? idInp.value : '';
      const newName = nameInp ? nameInp.value.trim() : '';
      const newLeader = leadInp ? leadInp.value.trim() : '';
      const newColor = colorInp ? colorInp.value : '';

      if (!targetId || !newName || !newLeader) {
        showToast('Please provide both Squadron Name and Commander Name.');
        return false;
      }

      const success = applyTeamUpdates(targetId, newName, newLeader, newColor);
      if (success) {
        closeEditTeamModal();
        showToast('Team updated successfully! 🚀');
      } else {
        showToast('Error: Target team could not be found.');
      }
      return false;
    }

    /* Legacy or table action edit trigger routes to dedicated modal */
    function editTeamFromTable(teamId) {
      openEditTeamModal(teamId);
    }

    function applyTeamUpdates(teamId, newName, newLeader, newColor) {
      const existingIndex = teams.findIndex(t => t.id === teamId);
      if (existingIndex !== -1) {
        const oldName = teams[existingIndex].name;
        teams[existingIndex].name = newName;
        teams[existingIndex].leader = newLeader;
        if (newColor) teams[existingIndex].color = newColor;

        roundHistory = roundHistory.map(h => {
          if (h.teamName === oldName) {
            return { ...h, teamName: newName };
          }
          return h;
        });

        if (selectedLeaderTeamId === teamId) {
          syncFormFieldsWithSelectedTeam();
        }

        persistState(true);
        renderAll();
        playCashChime();
        return true;
      }
      return false;
    }

    function handleTeamSubmit(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      const idInp = document.getElementById('reg-team-id');
      const nameInp = document.getElementById('reg-team-name');
      const leadInp = document.getElementById('reg-leader-name');
      const colorInp = document.getElementById('reg-team-color');

      const targetId = (idInp && idInp.value) ? idInp.value : selectedLeaderTeamId;
      const newName = nameInp ? nameInp.value.trim() : '';
      const newLeader = leadInp ? leadInp.value.trim() : '';
      const newColor = colorInp ? colorInp.value : '';

      if (!newName || !newLeader) {
        showToast('Please enter both Squadron Name and Commander Name.');
        return false;
      }

      const success = applyTeamUpdates(targetId, newName, newLeader, newColor);
      if (success) {
        const submitBtn = document.getElementById('reg-submit-btn');
        if (submitBtn) {
          const originalText = submitBtn.textContent;
          submitBtn.textContent = '✓ Updated!';
          submitBtn.classList.add('btn-reset-success');
          setTimeout(() => {
            submitBtn.textContent = originalText;
            submitBtn.classList.remove('btn-reset-success');
          }, 1500);
        }
        showToast('Team updated successfully! 🚀');
      } else {
        showToast('Error: Target squadron not found.');
      }
      return false;
    }

    /* 7. ROLE TOGGLING & MODAL */
    function switchRole(role) {
      currentRole = role;
      document.getElementById('tab-aud').classList.toggle('active', role === 'audience');
      document.getElementById('tab-sk').classList.toggle('active', role === 'scorekeeper');
      document.getElementById('tab-lead').classList.toggle('active', role === 'leader');

      const regSec = document.getElementById('registration-section');
      const skSec = document.getElementById('scorekeeper-section');
      if (regSec) regSec.style.display = role === 'leader' ? 'block' : 'none';
      if (skSec) skSec.style.display = role === 'scorekeeper' ? 'block' : 'none';

      if (role === 'leader') {
        syncFormFieldsWithSelectedTeam();
      }

      showToast(`Switched to ${role === 'leader' ? 'Team Leader' : role === 'scorekeeper' ? 'Scorekeeper & Admin' : 'Audience'} View`);
    }

    function toggleCollapse(id) {
      const el = document.getElementById(id);
      if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }

    function toggleAdminModal(open) {
      const modal = document.getElementById('admin-modal');
      if (modal) {
        modal.classList.toggle('open', open);
        if (open) renderAll();
      }
    }

    function switchAdminTab(tab) {
      document.getElementById('modal-tab-rounds').classList.toggle('active', tab === 'rounds');
      document.getElementById('modal-tab-points').classList.toggle('active', tab === 'points');
      document.getElementById('admin-pane-rounds').style.display = tab === 'rounds' ? 'flex' : 'none';
      document.getElementById('admin-pane-points').style.display = tab === 'points' ? 'flex' : 'none';
    }

    function toggleProjector(on) {
      document.body.classList.toggle('projector-active', on);
      if (on && document.documentElement.requestFullscreen) {
        document.documentElement.requestFullscreen().catch(()=>{});
      } else if (!on && document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen().catch(()=>{});
      }
    }

    /* 8. LIVE DEMO AUDIENCE SIMULATION */
    let demoInterval = null;
    function runDemoAudienceSimulation() {
      if (demoInterval) {
        clearInterval(demoInterval);
        demoInterval = null;
        showToast('Demo Simulation Stopped');
        return;
      }
      showToast('⚡ Running Live Demo Simulation across rounds...');
      playFanfare();
      let step = 0;
      demoInterval = setInterval(() => {
        step++;
        const randomTeam = teams[Math.floor(Math.random() * teams.length)];
        const r = getActiveRound();
        const pts = Math.random() > 0.5 ? r.first : r.second;
        scores[randomTeam.id] = (scores[randomTeam.id] || 0) + pts;
        addTeamRoundWin(randomTeam.id, r.id, r.name, pts === r.first ? 1 : 2, pts);
        logRound(r.id, r.name, randomTeam.name, pts === r.first ? '1st' : '2nd', pts);
        playCashChime();

        if (step % 2 === 0 && activeRoundId < GAME_ROUNDS.length) {
          activeRoundId++;
        }

        persistState();
        renderAll();

        if (step >= 8) {
          clearInterval(demoInterval);
          demoInterval = null;
          showToast('Live Demo Simulation Completed!');
          triggerConfetti();
        }
      }, 1200);
    }

    /* 9. CONFETTI EFFECT FOR FINISH STARGATE */
    function triggerConfetti() {
      const cvs = document.getElementById('confetti-canvas');
      const ctx = cvs.getContext('2d');
      cvs.width = window.innerWidth;
      cvs.height = window.innerHeight;
      const pieces = Array.from({ length: 90 }, () => ({
        x: Math.random() * cvs.width,
        y: -10,
        r: Math.random() * 6 + 3,
        color: ['#10b981', '#f59e0b', '#38bdf8', '#ec4899', '#fff'][Math.floor(Math.random() * 5)],
        vy: Math.random() * 4 + 2,
        vx: (Math.random() - 0.5) * 3
      }));

      let frames = 0;
      function animate() {
        ctx.clearRect(0, 0, cvs.width, cvs.height);
        pieces.forEach(p => {
          p.y += p.vy;
          p.x += p.vx;
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        });
        frames++;
        if (frames < 140) requestAnimationFrame(animate);
        else ctx.clearRect(0, 0, cvs.width, cvs.height);
      }
      animate();
    }

    /* 10. BACKGROUND COSMIC STARFIELD ANIMATION */
    const bgCvs = document.getElementById('space-bg-canvas');
    const bgCtx = bgCvs.getContext('2d');
    let stars = [];
    function resizeStars() {
      bgCvs.width = window.innerWidth;
      bgCvs.height = window.innerHeight;
      stars = Array.from({ length: 140 }, () => ({
        x: Math.random() * bgCvs.width,
        y: Math.random() * bgCvs.height,
        r: Math.random() * 1.5 + 0.3,
        a: Math.random(),
        da: (Math.random() - 0.5) * 0.02
      }));
    }
    function drawStars() {
      bgCtx.clearRect(0, 0, bgCvs.width, bgCvs.height);
      bgCtx.fillStyle = '#34d399';
      stars.forEach(s => {
        s.a += s.da;
        if (s.a <= 0.1 || s.a >= 0.95) s.da = -s.da;
        bgCtx.globalAlpha = Math.max(0.1, Math.min(1, s.a));
        bgCtx.beginPath();
        bgCtx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        bgCtx.fill();
      });
      requestAnimationFrame(drawStars);
    }
    window.addEventListener('resize', () => {
      resizeStars();
      renderAll();
    });

    /* BOOTSTRAP INITIALIZATION */
    initAppState();
    resizeStars();
    drawStars();
    renderAll();
  </script>
</body></html>