      if (subtitleEl) subtitleEl.textContent = `${teams.length} Finance Vessels in Flight`;

      const hudBar = document.getElementById('hud-standings-bar');
      if (hudBar) {
        hudBar.innerHTML = sorted.map((t, idx) => `
          <div style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; background:rgba(15,23,42,0.85); border:1px solid ${idx===0 ? '#f59e0b' : (t.color ? t.color + '44' : 'var(--border)')}; font-size:0.75rem; font-weight:700;">
